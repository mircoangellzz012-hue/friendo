<!DOCTYPE html>
<html lang="it"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Ryku</title>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#F4F5F9;--card:#fff;--ink:#12141C;--mute:#737891;--line:#E4E6EF;--ac:#7C5CFF;--them:#fff;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0D0E14;--card:#171923;--ink:#F0F1F7;--mute:#8C91AA;--line:#262938;--them:#222536}}
:root[data-theme="dark"]{--bg:#0D0E14;--card:#171923;--ink:#F0F1F7;--mute:#8C91AA;--line:#262938;--them:#222536}
html,body{height:100%;margin:0}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{background:var(--bg);color:var(--ink);font:16px 'Outfit',system-ui,sans-serif}
#app{display:flex;height:100%;max-width:560px;margin:0 auto}
#main{flex:1;min-width:0;overflow-y:auto;padding:16px 14px}
.rail{width:72px;flex:none;border-left:1px solid var(--line);background:var(--card);display:flex;flex-direction:column;gap:6px;padding:12px 6px}
.rb{position:relative;display:flex;flex-direction:column;align-items:center;gap:3px;padding:10px 0;border-radius:14px;font-size:11px;font-weight:600;color:var(--mute)}
.rb.a{background:var(--ac);color:#fff}
.bd{position:absolute;top:2px;right:8px;background:#E5484D;color:#fff;border-radius:9px;min-width:17px;height:17px;font-size:11px;display:grid;place-items:center;padding:0 4px}
svg.i{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round;flex:none}
h1,h2,h3{margin:0;font-weight:800}h2{font-size:26px;margin-bottom:12px}
.sub{color:var(--mute);font-size:14px}
button{font:inherit;border:0;background:none;color:inherit;cursor:pointer}
button:focus-visible{outline:3px solid var(--ac);outline-offset:2px}
.btn{background:var(--ac);color:#fff;font-weight:700;border-radius:12px;padding:11px 16px}
.btn.o{background:transparent;border:1.5px solid var(--line);color:var(--ink)}.w{width:100%}
input,textarea{width:100%;font:inherit;color:var(--ink);background:var(--card);border:1.5px solid var(--line);border-radius:12px;padding:11px 13px;outline:none}
input:focus,textarea:focus{border-color:var(--ac)}
label{display:block;font-weight:600;font-size:14px;margin:12px 0 5px}
.card{background:var(--card);border-radius:16px;padding:14px;margin-bottom:12px}
.list{background:var(--card);border-radius:16px;overflow:hidden;margin-bottom:12px}
.row{display:flex;align-items:center;gap:11px;padding:11px 12px;border-bottom:1px solid var(--line);cursor:pointer}.row:last-child{border:0}
.g{flex:1;min-width:0}.nm{font-weight:700}.pv{color:var(--mute);font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.av{width:46px;height:46px;border-radius:50%;flex:none;display:grid;place-items:center;color:#fff;font-weight:800;background-size:cover;background-position:center}
.av.s{width:36px;height:36px;font-size:14px}.av.l{width:78px;height:78px;font-size:28px;border:4px solid var(--card)}
.ib{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;flex:none}
.top{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.msgs{display:flex;flex-direction:column;gap:4px;padding:6px 0}
.b{max-width:84%;padding:8px 12px 5px;border-radius:18px 18px 18px 5px;background:var(--them);align-self:flex-start;overflow-wrap:anywhere}
.b.me{align-self:flex-end;background:var(--ac);color:#fff;border-radius:18px 18px 5px 18px}
.b small{display:block;text-align:right;font-size:11px;opacity:.7}
.b img,.b video{max-width:100%;border-radius:12px;display:block;margin-bottom:3px}
.cmp{display:flex;gap:6px;position:sticky;bottom:0;background:var(--bg);padding:8px 0 2px}
.cmp .btn{width:44px;padding:0;display:grid;place-items:center;border-radius:50%;flex:none}
.code{display:flex;justify-content:space-between;align-items:center;background:var(--ac);color:#fff;border-radius:16px;padding:14px 16px;margin-bottom:12px}
.code b{font-size:25px;letter-spacing:1.5px}.code small{opacity:.8;display:block}
.pc{background:var(--card);border-radius:16px;overflow:hidden;margin-bottom:12px}
.bn{height:100px;background-size:cover;background-position:center;position:relative}
.pb{padding:0 14px 14px;margin-top:-38px}
.cam{position:absolute;right:8px;top:8px;background:rgba(0,0,0,.45);color:#fff;width:34px;height:34px;border-radius:50%;display:grid;place-items:center}
.cam svg{width:18px;height:18px}
.ec{position:absolute;left:54px;top:50px;background:var(--ac);color:#fff;width:26px;height:26px;border-radius:50%;display:grid;place-items:center;border:2px solid var(--card)}
.ec svg{width:14px;height:14px}
.sw{display:flex;gap:9px;flex-wrap:wrap}.sw button{width:36px;height:36px;border-radius:50%;border:3px solid transparent}.sw .s{outline:2px solid var(--ink);outline-offset:1px}
.seg{display:flex;background:var(--bg);border-radius:12px;padding:3px}.seg button{flex:1;padding:8px;border-radius:10px;font-weight:600;font-size:14px;color:var(--mute)}.seg .s{background:var(--card);color:var(--ink)}
.tg{display:flex;justify-content:space-between;align-items:center;margin-top:12px;font-weight:600}
.tg button{width:48px;height:28px;border-radius:14px;background:var(--line);position:relative}.tg button::after{content:"";position:absolute;top:3px;left:3px;width:22px;height:22px;border-radius:50%;background:#fff;transition:left .15s}.tg .on{background:var(--ac)}.tg .on::after{left:23px}
iframe{width:100%;aspect-ratio:16/9;border:0;border-radius:14px;background:#000;margin-bottom:12px}
.empty{text-align:center;color:var(--mute);padding:22px 8px}
.err{background:rgba(229,72,77,.12);color:#E5484D;border-radius:12px;padding:10px 12px;font-size:14px;margin-bottom:10px}
.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(24px + env(safe-area-inset-bottom,0px));background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:12px;font-weight:600;font-size:14px;z-index:9}
.hero{max-width:420px;margin:0 auto;padding-top:8vh;text-align:center}
.hero .lg{width:70px;height:70px;border-radius:22px;background:var(--ac);color:#fff;display:grid;place-items:center;margin:0 auto 14px;font-size:38px;font-weight:800}
.hero .card{text-align:left;margin-top:20px}
</style></head><body><div id="app"><div id="main"></div><nav class="rail" id="rail"></nav></div>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.js"></script>
<script>
const P={chat:'M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.5-4.6A8 8 0 1 1 21 12z',music:'M9 18V5l11-2v13M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM20 16a3 3 0 1 1-6 0 3 3 0 0 1 6 0z',set:'M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0M14 4v4M8 10v4M16 16v4',back:'M15 5l-7 7 7 7',send:'M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z',img:'M4 5h16v14H4zM4 16l5-5 4 4 3-3 4 4',copy:'M9 9h11v11H9zM5 15V4h11',plus:'M12 5v14M5 12h14',cam:'M3 8h4l2-3h6l2 3h4v12H3zM12 17a4 4 0 1 0 0-8 4 4 0 0 0 0 8z',pen:'M4 20l1-4L16 5l3 3L8 19z',play:'M6 4l14 8-14 8z',del:'M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13',chk:'M4 12l5 5L20 6'};
const ic=n=>`<svg class="i" viewBox="0 0 24 24"><path d="${P[n]}"/></svg>`;
const $=s=>document.querySelector(s);
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const ld=k=>{try{return localStorage.getItem(k)}catch(e){return null}},sv=(k,v)=>{try{localStorage.setItem(k,v)}catch(e){}};
const ACC=['#7C5CFF','#FF4F8B','#1DB9A0','#F5A623','#3AA0FF','#E5484D'];
const GR=['linear-gradient(135deg,#7C5CFF,#B07CFF)','linear-gradient(135deg,#FF6B8B,#FFA06B)','linear-gradient(135deg,#1DB9A0,#5BD08B)','linear-gradient(135deg,#F5A623,#F55B5B)','linear-gradient(135deg,#3AA0FF,#5B5BF5)'];
const REP=['Ahah ci sto','Dimmi tutto','Ok perfetto','Ti scrivo tra poco','Che bella idea','Davvero? Racconta','Ci vediamo dopo'];
const SB_URL='https://nwyxtsiwwepyxmdgmbbs.supabase.co',SB_KEY='eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im53eXh0c2l3d2VweXhtZGdtYmJzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTQwODI4MDcsImV4cCI6MjEwOTY1ODgwN30.TeSYsU66Mu8gVfiWDHi8WTlC34tGH1hdFN0zdcReVww';
const db=supabase.createClient(SB_URL,SB_KEY);
let me=null,fr=[],inc=[],pend=[],msgs={},lr=JSON.parse(ld('lr2')||'{}'),tab='chat',open=null,mode='in',err='',toastT,cur='',res=null,query='',draft='',confirmDel=0;
const ST=JSON.parse(ld('ryku_st')||'{}');ST.ac=ST.ac||ACC[0];ST.th=ST.th||'auto';ST.bc=ST.bc||0;
const stSave=()=>sv('ryku_st',JSON.stringify(ST));
let TR=JSON.parse(ld('ryku_tr')||'[]');const save=()=>sv('ryku_tr',JSON.stringify(TR));
const L=n=>Array.from({length:n},()=>'ABCDEFGHJKLMNPQRSTUVWXYZ'[Math.floor(Math.random()*24)]).join('');
const newCode=()=>L(3)+'-'+(10+Math.floor(Math.random()*90))+'-'+L(2);
const ini=n=>(n||'?').split(/\s+/).map(w=>w[0]).join('').slice(0,2).toUpperCase();
const gi=s=>[...(s||'')].reduce((a,c)=>a+c.charCodeAt(0),0)%5;
const av=(f,c='')=>`<div class="av ${c}" style="background:${f.avatar?`url(${f.avatar})`:GR[gi(f.username)]};background-size:cover;background-position:center">${f.avatar?'':ini(f.name)}</div>`;
const tm=t=>{const d=new Date(t);return d.getHours()+':'+String(d.getMinutes()).padStart(2,'0')};
const tick=`<svg viewBox="0 0 24 24" class="i" style="width:13px;height:13px;display:inline"><path d="${P.chk}"/></svg>`;
function toast(t){clearTimeout(toastT);const o=$('.toast');if(o)o.remove();const d=document.createElement('div');d.className='toast';d.textContent=t;document.body.appendChild(d);toastT=setTimeout(()=>d.remove(),2400)}
const yt=u=>{const m=String(u).match(/(?:youtu\.be\/|v=|embed\/|shorts\/)([\w-]{11})/);return m?m[1]:null};
function music(){
  const T=TR;
  $('#main').innerHTML=`<h2>Musica</h2><div class="card"><div style="display:flex;gap:8px"><input id="sq" placeholder="Cerca su YouTube" autocomplete="off"><button class="btn" id="ss">Cerca</button></div>
  <p class="sub" style="margin:8px 0 0">Si apre YouTube: copia il link del brano e incollalo qui sotto.</p>
  <label for="ml">Link YouTube</label><input id="ml" placeholder="https://youtu.be/..." autocapitalize="none"><label for="mt">Titolo (facoltativo)</label><input id="mt" maxlength="40"><button class="btn w" id="ma" style="margin-top:12px">Aggiungi e ascolta</button></div>
  ${cur?`<iframe src="https://www.youtube-nocookie.com/embed/${cur}?autoplay=1&playsinline=1" allow="autoplay; encrypted-media; fullscreen" title="Player YouTube"></iframe>`:''}
  ${T.length?`<div class="list">${T.map((t,i)=>`<div class="row" data-p="${t.id}"><div class="ib" style="background:var(--ac);color:#fff">${ic('play')}</div><div class="g"><div class="nm">${esc(t.t)}</div></div><button class="ib" data-d="${i}" aria-label="Elimina">${ic('del')}</button></div>`).join('')}</div>`:`<div class="empty">La tua playlist è vuota.</div>`}`;
  $('#ss').onclick=()=>{const q=$('#sq').value.trim();if(q)window.open('https://www.youtube.com/results?search_query='+encodeURIComponent(q),'_blank')};
  $('#ma').onclick=()=>{const id=yt($('#ml').value);if(!id)return toast('Link YouTube non valido');TR.push({id,t:$('#mt').value.trim()||'Brano '+(T.length+1)});cur=id;save();music()};
  document.querySelectorAll('[data-p]').forEach(r=>r.onclick=e=>{if(e.target.closest('[data-d]'))return;cur=r.dataset.p;music()});
  document.querySelectorAll('[data-d]').forEach(b=>b.onclick=()=>{TR.splice(+b.dataset.d,1);save();music()});
}
function theme(){const r=document.documentElement;r.style.setProperty('--ac',ST.ac);if(ST.th!=='auto')r.setAttribute('data-theme',ST.th);else r.removeAttribute('data-theme')}
const fmt=t=>tm(new Date(t));
const unread=f=>(msgs[f.id]||[]).filter(m=>m.from_id!==me.id&&new Date(m.created_at)>(lr[f.id]||0)).length;
const add=x=>{const k=x.from_id===me.id?x.to_id:x.from_id,a=msgs[k]=msgs[k]||[];if(!a.some(y=>y.id===x.id))a.push(x)};
const imgBlob=(file,max)=>new Promise(r=>{const im=new Image();im.onload=()=>{const k=Math.min(1,max/Math.max(im.width,im.height)),c=document.createElement('canvas');c.width=im.width*k;c.height=im.height*k;c.getContext('2d').drawImage(im,0,0,c.width,c.height);c.toBlob(r,'image/jpeg',.82)};im.src=URL.createObjectURL(file)});
function pickImg(w,h,cb){const i=document.createElement('input');i.type='file';i.accept='image/*';i.onchange=()=>{const f=i.files[0];if(!f)return;const im=new Image();im.onload=()=>{const k=Math.max(w/im.width,h/im.height),c=document.createElement('canvas');c.width=w;c.height=h;c.getContext('2d').drawImage(im,(w-im.width*k)/2,(h-im.height*k)/2,im.width*k,im.height*k);c.toBlob(cb,'image/jpeg',.82)};im.src=URL.createObjectURL(f)};i.click()}
async function up(blob,ext,type){const p=me.id+'/'+Date.now()+'.'+ext.replace(/[^a-z0-9]/gi,'').slice(0,5);const {error}=await db.storage.from('media').upload(p,blob,{contentType:type});if(error)throw error;return db.storage.from('media').getPublicUrl(p).data.publicUrl}
async function loadAll(){
  const {data:f}=await db.from('friendships').select('*');
  const ids=[...new Set((f||[]).flatMap(x=>[x.from_id,x.to_id]))].filter(i=>i!==me.id);
  const Q={};if(ids.length){const {data:p}=await db.from('profiles').select('*').in('id',ids);(p||[]).forEach(x=>Q[x.id]=x)}
  fr=[];inc=[];pend=[];
  (f||[]).forEach(x=>{const o=Q[x.from_id===me.id?x.to_id:x.from_id];if(!o)return;if(x.status==='accepted')fr.push(o);else if(x.to_id===me.id)inc.push({...o,fid:x.id});else pend.push(o.id)});
  const {data:m}=await db.from('messages').select('*').order('created_at').limit(1000);
  msgs={};(m||[]).forEach(add);
}
async function loadMe(id){
  const {data}=await db.from('profiles').select('*').eq('id',id).maybeSingle();
  if(!data){await db.auth.signOut();return}
  me=data;await loadAll();subscribe();
}
function notify(f,x){toast('Nuovo messaggio da '+f.name);try{if(navigator.vibrate)navigator.vibrate(80);if(document.hidden&&window.Notification&&Notification.permission==='granted')new Notification(f.name,{body:x.body||'Foto o video'})}catch(e){}}
function subscribe(){
  db.channel('rt')
   .on('postgres_changes',{event:'INSERT',schema:'public',table:'messages'},p=>{const x=p.new;add(x);if(x.from_id!==me.id){const f=fr.find(y=>y.id===x.from_id);if(f&&open!==f.id)notify(f,x)}ref()})
   .on('postgres_changes',{event:'*',schema:'public',table:'friendships'},async()=>{await loadAll();ref()})
   .subscribe();
}
function ref(){if(!me)return;if(open)return chatView();const a=document.activeElement;if(tab!=='chat'||(a&&a.id==='fc'))return;render()}
function render(){
  theme();if(!me)return auth();
  const un=fr.reduce((a,f)=>a+unread(f),0)+inc.length;
  $('#rail').style.display='flex';
  $('#rail').innerHTML=[['chat','Chat','chat'],['music','Musica','music'],['set','Impost.','set']].map(t=>`<button class="rb ${tab===t[0]&&!open?'a':''}" data-t="${t[0]}" aria-label="${t[1]}">${ic(t[2])}${t[1]}${t[0]==='chat'&&un?`<span class="bd">${un}</span>`:''}</button>`).join('');
  document.querySelectorAll('.rb').forEach(b=>b.onclick=()=>{tab=b.dataset.t;open=null;render()});
  if(open)return chatView();
  ({chat:chats,music:music,set:settings})[tab]();
}
function fail(m){const u=$('#u').value,n=$('#n')?$('#n').value:'';err=m;auth();$('#u').value=u;if($('#n'))$('#n').value=n}
function auth(){
  $('#rail').style.display='none';const su=mode==='up';
  $('#main').innerHTML=`<div class="hero"><div class="lg">R</div><h1>Ryku</h1><p class="sub">Chatta, ascolta musica, personalizza tutto.</p><div class="card">${err?`<div class="err">${esc(err)}</div>`:''}
  ${su?`<label style="margin-top:0" for="n">Nome</label><input id="n" maxlength="24" placeholder="es. Luna Ferri">`:''}
  <label ${su?'':'style="margin-top:0"'} for="u">Nickname</label><input id="u" maxlength="16" autocapitalize="none" autocomplete="username" placeholder="es. luna_f">
  <label for="p">Password</label><input id="p" type="password" autocomplete="${su?'new-password':'current-password'}" placeholder="Almeno 6 caratteri">
  <button class="btn w" id="go" style="margin-top:14px">${su?'Crea account':'Accedi'}</button><button class="btn o w" id="sw" style="margin-top:8px">${su?'Ho già un account':'Crea un nuovo account'}</button></div></div>`;
  $('#sw').onclick=()=>{mode=su?'in':'up';err='';auth()};
  $('#go').onclick=async()=>{
    const u=$('#u').value.trim().toLowerCase(),pw=$('#p').value;
    if(!/^[a-z0-9._]{3,16}$/.test(u))return fail('Nickname: da 3 a 16 caratteri, solo lettere, numeri, punto o trattino basso');
    if(pw.length<6)return fail('La password deve avere almeno 6 caratteri');
    $('#go').disabled=true;const email=u+'@friendo.app';
    try{if(window.Notification&&Notification.permission==='default')Notification.requestPermission()}catch(e){}
    try{let r;
      if(su){r=await db.auth.signUp({email,password:pw});if(r.error)throw r.error;if(!r.data.session)throw new Error('Su Supabase devi spegnere Confirm email');
        let q;for(let i=0;i<3;i++){q=await db.from('profiles').insert({id:r.data.user.id,username:u,name:$('#n').value.trim()||u,code:newCode()});if(!q.error||!String(q.error.message).includes('code'))break}
        if(q.error)throw q.error}
      else{r=await db.auth.signInWithPassword({email,password:pw});if(r.error)throw r.error}
      await loadMe(r.data.user.id);err='';render();
    }catch(e){const m=e.message||'Errore';fail(m.includes('Invalid login')?'Nickname o password sbagliati':m.includes('already')?'Nickname già preso':m)}
  };
}
async function find(){const q=($('#fc').value||'').trim().replace(/^@/,'').replace(/[^a-zA-Z0-9._-]/g,'');query=q;if(!q){res=null;return chats()}
  const {data}=await db.from('profiles').select('*').or(`username.ilike.${q.toLowerCase()}%,code.eq.${q.toUpperCase()}`).neq('id',me.id).limit(10);res=data||[];chats()}
function chats(){
  const rq=inc.length?`<div class="list">${inc.map(p=>`<div class="row" style="cursor:default">${av(p)}<div class="g"><div class="nm">${esc(p.name)}</div><div class="pv">vuole essere tuo amico</div></div><button class="btn" style="padding:8px 12px" data-ok="${p.fid}">Accetta</button><button class="ib" data-no="${p.fid}" aria-label="Rifiuta">${ic('del')}</button></div>`).join('')}</div>`:'';
  const rs=res?(res.length?`<div class="list">${res.map(d=>{const a=fr.some(f=>f.id===d.id),p=pend.includes(d.id);return `<div class="row" style="cursor:default">${av(d)}<div class="g"><div class="nm">${esc(d.name)}</div><div class="pv">@${esc(d.username)}</div></div><button class="btn" style="padding:8px 12px" data-a="${d.id}" ${a||p?'disabled':''}>${a?'Amici':p?'Inviata':'Aggiungi'}</button></div>`}).join('')}</div>`:`<div class="empty">Nessun utente trovato.</div>`):'';
  const last=f=>{const l=(msgs[f.id]||[]).slice(-1)[0];return l?+new Date(l.created_at):0};
  const rows=[...fr].sort((a,b)=>last(b)-last(a)).map(f=>{const l=(msgs[f.id]||[]).slice(-1)[0],u=unread(f);return `<div class="row" data-id="${f.id}">${av(f)}<div class="g"><div class="nm">${esc(f.name)}</div><div class="pv">${l?(l.from_id===me.id?'Tu: ':'')+esc(l.body||(l.media_type==='video'?'Video':'Foto')):'Nessun messaggio'}</div></div>${u?`<span class="bd" style="position:static">${u}</span>`:''}</div>`}).join('');
  $('#main').innerHTML=`<h2>Chat</h2><div class="card" style="display:flex;gap:8px;padding:10px"><input id="fc" placeholder="Cerca @nickname o codice" value="${esc(query)}" autocomplete="off" autocapitalize="none"><button class="btn" id="fs" aria-label="Cerca">${ic('plus')}</button></div>${rq}${rs}
  ${rows?`<div class="list">${rows}</div>`:`<div class="empty">Nessun amico ancora.<br>Cerca qualcuno con il suo codice.</div>`}`;
  $('#fs').onclick=find;$('#fc').onkeydown=e=>{if(e.key==='Enter')find()};
  document.querySelectorAll('.row[data-id]').forEach(r=>r.onclick=()=>{open=r.dataset.id;render()});
  document.querySelectorAll('[data-a]').forEach(b=>b.onclick=async()=>{const r=await db.from('friendships').insert({from_id:me.id,to_id:b.dataset.a});if(r.error)return toast('Richiesta non inviata');toast('Richiesta inviata');await loadAll();chats()});
  document.querySelectorAll('[data-ok]').forEach(b=>b.onclick=async()=>{await db.from('friendships').update({status:'accepted'}).eq('id',b.dataset.ok);await loadAll();render()});
  document.querySelectorAll('[data-no]').forEach(b=>b.onclick=async()=>{await db.from('friendships').delete().eq('id',b.dataset.no);await loadAll();render()});
}
function chatView(){
  const d=$('#tx'),had=d&&document.activeElement===d;if(d)draft=d.value;
  const f=fr.find(x=>x.id===open);if(!f){open=null;return render()}
  lr[f.id]=Date.now();sv('lr2',JSON.stringify(lr));
  const mh=m=>`<div class="b ${m.from_id===me.id?'me':''}">${m.media_url?(m.media_type==='video'?`<video src="${esc(m.media_url)}" controls playsinline></video>`:`<img src="${esc(m.media_url)}" alt="Foto">`):''}${m.body?esc(m.body):''}<small>${fmt(m.created_at)}${m.from_id===me.id?' '+tick+tick:''}</small></div>`;
  $('#main').innerHTML=`<div class="top"><button class="ib" id="bk" aria-label="Indietro">${ic('back')}</button>${av(f,'s')}<div><div class="nm">${esc(f.name)}</div><div class="sub">@${esc(f.username)}</div></div></div>
  <div class="msgs">${(msgs[f.id]||[]).map(mh).join('')}</div><div class="cmp"><button class="ib" id="at" aria-label="Allega foto o video">${ic('img')}</button><input id="tx" placeholder="Messaggio" autocomplete="off"><button class="btn" id="sd" aria-label="Invia">${ic('send')}</button></div>`;
  $('#tx').value=draft;if(had)$('#tx').focus();$('#main').scrollTop=1e6;
  $('#bk').onclick=()=>{open=null;draft='';render()};
  const go=async()=>{const v=$('#tx').value.trim();if(!v)return;$('#tx').value='';draft='';const r=await db.from('messages').insert({from_id:me.id,to_id:f.id,body:v}).select().single();if(r.error)return toast('Invio non riuscito');add(r.data);chatView()};
  $('#sd').onclick=go;$('#tx').onkeydown=e=>{if(e.key==='Enter')go()};
  $('#at').onclick=()=>{const i=document.createElement('input');i.type='file';i.accept='image/*,video/*';i.onchange=async()=>{const fl=i.files[0];if(!fl)return;toast('Invio in corso...');
    try{const vid=fl.type.startsWith('video');const url=vid?await up(fl,fl.name.split('.').pop()||'mp4',fl.type):await up(await imgBlob(fl,1280),'jpg','image/jpeg');
      const r=await db.from('messages').insert({from_id:me.id,to_id:f.id,media_url:url,media_type:vid?'video':'image'}).select().single();if(r.error)throw r.error;add(r.data);chatView()}
    catch(e){toast('Invio non riuscito: '+(e.message||''))}};i.click()};
}
async function upd(o){const r=await db.from('profiles').update(o).eq('id',me.id).select().single();if(r.error)return toast('Errore: '+r.error.message);me=r.data;settings()}
function settings(){
  const bn=me.banner?`url(${esc(me.banner)})`:GR[ST.bc%5];
  $('#main').innerHTML=`<div class="code"><div><small>Il tuo codice</small><b>${me.code}</b></div><button class="ib" id="cp" aria-label="Copia codice">${ic('copy')}</button></div>
  <div class="pc"><div class="bn" style="background-image:${bn}"><button class="cam" id="cb" aria-label="Cambia banner">${ic('cam')}</button></div><div class="pb"><div style="position:relative;width:78px">${av(me,'l')}<button class="ec" id="cf" aria-label="Cambia foto">${ic('pen')}</button></div><h3 style="margin-top:8px">${esc(me.name)}</h3><div class="sub">@${esc(me.username)}</div><p style="margin:6px 0 0">${me.bio?esc(me.bio):'<span class="sub">Nessuna bio</span>'}</p></div></div>
  <div class="card"><label style="margin-top:0" for="n2">Nome</label><input id="n2" maxlength="24" value="${esc(me.name)}"><label for="b2">Bio</label><textarea id="b2" rows="2" maxlength="80" placeholder="Scrivi qualcosa su di te">${esc(me.bio||'')}</textarea><button class="btn w" id="sv" style="margin-top:12px">Salva profilo</button></div>
  <div class="card"><h3 style="font-size:17px">Banner</h3><div class="sw" style="margin-top:10px">${GR.map((g,i)=>`<button data-bc="${i}" class="${!me.banner&&ST.bc===i?'s':''}" style="background:${g}" aria-label="Banner ${i+1}"></button>`).join('')}</div>
  <h3 style="font-size:17px;margin-top:16px">Tema</h3><div class="sw" style="margin-top:10px">${ACC.map(c=>`<button data-ac="${c}" class="${ST.ac===c?'s':''}" style="background:${c}" aria-label="Colore ${c}"></button>`).join('')}</div>
  <div class="seg" style="margin-top:14px">${[['auto','Sistema'],['light','Chiaro'],['dark','Scuro']].map(t=>`<button data-th="${t[0]}" class="${ST.th===t[0]?'s':''}">${t[1]}</button>`).join('')}</div></div>
  <button class="btn o w" id="lo">Esci</button>`;
  $('#cp').onclick=()=>{try{navigator.clipboard.writeText(me.code).then(()=>toast('Codice copiato'),()=>toast('Copia non disponibile'))}catch(e){toast('Copia non disponibile')}};
  $('#cf').onclick=()=>pickImg(256,256,async b=>{toast('Caricamento...');try{upd({avatar:await up(b,'jpg','image/jpeg')})}catch(e){toast('Caricamento non riuscito')}});
  $('#cb').onclick=()=>pickImg(900,300,async b=>{toast('Caricamento...');try{upd({banner:await up(b,'jpg','image/jpeg')})}catch(e){toast('Caricamento non riuscito')}});
  $('#sv').onclick=()=>upd({name:$('#n2').value.trim()||me.name,bio:$('#b2').value.slice(0,80)});
  document.querySelectorAll('[data-bc]').forEach(b=>b.onclick=async()=>{ST.bc=+b.dataset.bc;stSave();if(me.banner)await upd({banner:null});else settings()});
  document.querySelectorAll('[data-ac]').forEach(b=>b.onclick=()=>{ST.ac=b.dataset.ac;stSave();theme();settings()});
  document.querySelectorAll('[data-th]').forEach(b=>b.onclick=()=>{ST.th=b.dataset.th;stSave();theme();settings()});
  $('#lo').onclick=async()=>{await db.removeAllChannels();await db.auth.signOut();me=null;fr=[];msgs={};open=null;tab='chat';render()};
}
(async()=>{
  try{const {data}=await db.auth.getSession();if(data.session)await loadMe(data.session.user.id)}catch(e){err='Non riesco a collegarmi al server'}
  render();
})();
</script></body></html>
